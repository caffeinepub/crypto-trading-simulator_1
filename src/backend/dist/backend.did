type TransformArgs = 
 record {
   context: blob;
   response: HttpResponse;
 };
type Message = 
 record {
   content: text;
   role: text;
 };
type HttpResponse = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
service : {
  getChatHistory: () -> (vec Message) query;
  getCompanionPreference: () -> (opt text) query;
  saveChatHistory: (history: vec Message) -> ();
  saveCompanionPreference: (preference: text) -> ();
  transform: (args: TransformArgs) -> (HttpResponse) query;
}
